{
  "name": "voicereader-desktop",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "sidecar:build": "python ./tts-engine/scripts/build_sidecar.py",
    "models:bundle:kyutai": "python ./tts-engine/scripts/build_sidecar.py --models-only",
    "onnxruntime:fetch": "node scripts/fetch-onnxruntime.js",
    "kyutai-voices:fetch": "node scripts/fetch-kyutai-voices.js",
    "test:player": "node scripts/test-tempo-stretch.mjs",
    "assets:fetch": "npm run onnxruntime:fetch && node scripts/fetch-webgpu-macos.js && npm run kyutai-voices:fetch",
    "predesktop:dev": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:dev": "tauri dev --features build-base",
    "predesktop:dev:full": "node scripts/sync-version.js",
    "desktop:dev:full": "tauri dev --features build-full",
    "predesktop:dev:base": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:dev:base": "tauri dev --features build-base",
    "desktop:build": "npm run desktop:build:base",
    "predesktop:build:full": "node scripts/sync-version.js",
    "desktop:build:full": "tauri build --features build-full",
    "predesktop:build:base": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:build:base": "tauri build --features build-base --config src-tauri/tauri.base.conf.json --bundles none",
    "predesktop:build:base:installer": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:build:base:installer": "tauri build --features build-base --config src-tauri/tauri.base.conf.json",
    "desktop:build:standalone": "npm run desktop:build:base:installer",
    "desktop:build:portable": "npm run desktop:build:base:portable",
    "predesktop:build:macos:portable": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:build:macos:portable": "tauri build --features build-base --config src-tauri/tauri.macos.conf.json --bundles app && python3 ./scripts/package_portable.py --variant base",
    "predesktop:build:full:portable": "node scripts/sync-version.js",
    "desktop:build:full:portable": "npm run sidecar:build && npm run build && tauri build --features build-full --bundles none && python ./scripts/package_portable.py --variant full",
    "predesktop:build:base:portable": "node scripts/sync-version.js && npm run assets:fetch",
    "desktop:build:base:portable": "npm run models:bundle:kyutai && npm run build && tauri build --features build-base --config src-tauri/tauri.base.conf.json --bundles none && python ./scripts/package_portable.py --variant base"
  },
  "dependencies": {
    "@tauri-apps/api": "^1.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^1.6.0",
    "typescript": "^5.9.2",
    "vite": "^5.4.11"
  }
}
