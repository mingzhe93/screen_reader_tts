{
  "build": {
    "beforeBuildCommand": "python3 tts-engine/scripts/build_sidecar.py --models-only && npm run build"
  },
  "tauri": {
    "macOSPrivateApi": true,
    "bundle": {
      "icon": ["icons/icon.icns"],
      "resources": [
        "binaries/models/**/*",
        "binaries/onnxruntime/**/*",
        "binaries/sox-macos/**/*",
        "binaries/kyutai-voices/**/*"
      ],
      "macOS": {
        "minimumSystemVersion": "14.0"
      }
    }
  }
}
